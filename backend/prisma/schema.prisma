generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Role {
  CLIENT
  LAWYER
  ADMIN
}

enum CaseStatus {
  open
  in_progress
  resolved
  closed
}

enum CasePriority {
  low
  medium
  high
}

model User {
  id             String         @id @default(cuid())
  walletAddress  String?        @unique
  email          String?        @unique
  passwordHash   String?
  role           Role           @default(CLIENT)
  name           String         @default("Anonymous User")
  avatarUrl      String?
  phone          String?
  city           String?
  trustScore     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  verifications  Verification[]
  trustLogs      TrustLog[]
  lawyerProfile  Lawyer?
  reviewsWritten Review[]
  appointments   Appointment[]
  cases          Case[]
  documents      Document[]
  savedLawyers   SavedLawyer[]
}

model Verification {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimType    String              @default("GENERAL_CREDENTIAL")
  claimData    String
  status       VerificationStatus  @default(PENDING)
  scoreImpact  Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model TrustLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  pointsDelta Int
  newScore    Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Lawyer {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  avatarUrl            String
  verified             Boolean  @default(false)
  online               Boolean  @default(false)
  gender               String
  experienceYears      Int
  qualification        String
  court                String
  languages            String[]
  specializations      String[]
  rating               Float    @default(0)
  reviewCount          Int      @default(0)
  consultationFee      Int
  consultationTypes    String[]
  responseTimeMinutes  Int
  city                 String
  state                String
  bio                  String
  casesWon             Int      @default(0)
  successRate          Int      @default(0)
  joinedAt             DateTime @default(now())

  // Extended profile fields (all optional for backwards compatibility)
  title                String?  // e.g. "Advocate, Supreme Court"
  subtitle             String?  // e.g. "Bar Council · District Court"
  barNumber            String?
  barCouncilName       String?
  phone                String?
  whatsapp             String?
  website              String?
  linkedin             String?
  onlineConsultation   Boolean  @default(true)
  offlineConsultation  Boolean  @default(false)
  workingDays          String?  // e.g. "Mon - Sat"
  workingHours         String?  // e.g. "10:00 AM - 6:00 PM"

  reviews              Review[]
  appointments         Appointment[]
  cases                Case[]
  savedBy              SavedLawyer[]

  // Rich profile relations
  education            LawyerEducation[]
  timeline             LawyerTimeline[]
  courtMemberships     LawyerCourtMembership[]
  faqs                 LawyerFAQ[]
  officeLocations      LawyerOffice[]
  gallery              LawyerGalleryImage[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([city])
  @@index([rating])
  @@index([consultationFee])
}

model LawyerEducation {
  id          String @id @default(cuid())
  lawyerId    String
  lawyer      Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  year        Int
  order       Int    @default(0)

  @@index([lawyerId])
}

model LawyerTimeline {
  id          String @id @default(cuid())
  lawyerId    String
  lawyer      Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  year        String
  title       String
  description String
  order       Int    @default(0)

  @@index([lawyerId])
}

model LawyerCourtMembership {
  id        String @id @default(cuid())
  lawyerId  String
  lawyer    Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  courtName String
  since     Int
  order     Int    @default(0)

  @@index([lawyerId])
}

model LawyerFAQ {
  id       String @id @default(cuid())
  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  question String
  answer   String
  order    Int    @default(0)

  @@index([lawyerId])
}

model LawyerOffice {
  id       String @id @default(cuid())
  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  name     String
  address  String
  city     String
  state    String
  pincode  String?
  mapsLink String?
  order    Int     @default(0)

  @@index([lawyerId])
}

model LawyerGalleryImage {
  id       String @id @default(cuid())
  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  url      String
  caption  String?
  type     String  @default("photo") // photo | certificate | office
  order    Int     @default(0)

  @@index([lawyerId])
}


model PracticeArea {
  id           String @id
  name         String @unique
  icon         String
  description  String
  casesServed  Int    @default(0)
}

model Review {
  id              String   @id @default(cuid())
  lawyerId        String
  lawyer          Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorAvatarUrl String?
  rating          Int
  comment         String
  verifiedClient  Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([lawyerId])
}

enum AppointmentStatus {
  pending
  upcoming
  completed
  cancelled
}

model Appointment {
  id              String            @id @default(cuid())
  clientId        String
  client          User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName      String
  lawyerId        String
  lawyer          Lawyer            @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerName      String
  lawyerAvatarUrl String
  date            DateTime
  type            String
  status          AppointmentStatus @default(pending)
  fee             Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clientId])
  @@index([lawyerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderName     String?
  receiverId     String?
  text           String
  attachment     String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  name      String
  category  String
  sizeLabel String   @default("1.0 MB")
  url       String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

model SavedLawyer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lawyerId])
  @@index([userId])
}

model Case {
  id           String       @id @default(cuid())
  clientId     String
  client       User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lawyerId     String?
  lawyer       Lawyer?      @relation(fields: [lawyerId], references: [id], onDelete: SetNull)
  title        String
  description  String
  practiceArea String
  status       CaseStatus   @default(open)
  priority     CasePriority @default(medium)
  notes                String?
  deletionRequestedBy  String?      // "client" | "lawyer" | null
  documents            Document[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Role {
  CLIENT
  LAWYER
  ADMIN
}

model User {
  id             String         @id @default(cuid())
  walletAddress  String?        @unique
  email          String?        @unique
  passwordHash   String?
  role           Role           @default(CLIENT)
  name           String         @default("Anonymous User")
  trustScore     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  verifications  Verification[]
  trustLogs      TrustLog[]
  lawyerProfile  Lawyer?
  reviewsWritten Review[]
  appointments   Appointment[]
  documents      Document[]
  savedLawyers   SavedLawyer[]
}

model Verification {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimType    String              @default("GENERAL_CREDENTIAL")
  claimData    String
  status       VerificationStatus  @default(PENDING)
  scoreImpact  Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model TrustLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  pointsDelta Int
  newScore    Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Lawyer {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  avatarUrl            String
  verified             Boolean  @default(false)
  online               Boolean  @default(false)
  gender               String
  experienceYears      Int
  qualification        String
  court                String
  languages            String[]
  specializations      String[]
  rating               Float    @default(0)
  reviewCount          Int      @default(0)
  consultationFee      Int
  consultationTypes    String[]
  responseTimeMinutes  Int
  city                 String
  state                String
  bio                  String
  casesWon             Int      @default(0)
  successRate          Int      @default(0)
  joinedAt             DateTime @default(now())

  reviews              Review[]
  appointments         Appointment[]
  savedBy              SavedLawyer[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([city])
  @@index([rating])
  @@index([consultationFee])
}

model PracticeArea {
  id           String @id
  name         String @unique
  icon         String
  description  String
  casesServed  Int    @default(0)
}

model Review {
  id              String   @id @default(cuid())
  lawyerId        String
  lawyer          Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorAvatarUrl String?
  rating          Int
  comment         String
  verifiedClient  Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([lawyerId])
}

enum AppointmentStatus {
  pending
  upcoming
  completed
  cancelled
}

model Appointment {
  id              String            @id @default(cuid())
  clientId        String
  client          User              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName      String
  lawyerId        String
  lawyer          Lawyer            @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerName      String
  lawyerAvatarUrl String
  date            DateTime
  type            String
  status          AppointmentStatus @default(pending)
  fee             Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clientId])
  @@index([lawyerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderName     String?
  receiverId     String?
  text           String
  attachment     String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  sizeLabel String   @default("1.0 MB")
  url       String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedLawyer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lawyerId])
  @@index([userId])
}
